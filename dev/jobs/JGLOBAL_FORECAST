#! /usr/bin/env bash

# JGLOBAL_FORECAST
# This J-Job follows EE2 standards by explicitly defining COM paths.

source "${HOMEgfs}/ush/jjob_header.sh" -e "fcst" -c "base fcst"

###############################################################
# EE2 Compliant COM Path Definitions
# Resolved from templates for explicit visibility
###############################################################

# Base COM directory for the current cycle
# shellcheck disable=SC2153
export COM_BASE="${ROTDIR}/${RUN}.${PDY}/${cyc}"

# Atmos components
export COMIN_ATMOS_INPUT="${COM_BASE}/model/atmos/input"
export COMOUT_CONF="${COM_BASE}/conf"
export COMOUT_ATMOS_RESTART="${COM_BASE}/model/atmos/restart"
export COMIN_ATMOS_RESTART="${COM_BASE}/model/atmos/restart"
export COMOUT_ATMOS_HISTORY="${COM_BASE}/model/atmos/history"
export COMOUT_ATMOS_MASTER="${COM_BASE}/model/atmos/master"
export COMIN_ATMOS_ANALYSIS="${COM_BASE}/analysis/atmos"

# Coupled components (if enabled)
if [[ "${DO_WAVE}" == "YES" ]]; then
    export COMIN_WAVE_PREP="${COM_BASE}/model/wave/prep"
    export COMOUT_WAVE_RESTART="${COM_BASE}/model/wave/restart"
    export COMOUT_WAVE_HISTORY="${COM_BASE}/model/wave/history"
fi

if [[ "${DO_OCN}" == "YES" ]]; then
    export COMIN_OCEAN_ANALYSIS="${COM_BASE}/analysis/ocean"
    export COMIN_OCEAN_INPUT="${COM_BASE}/model/ocean/input"
    export COMOUT_MED_RESTART="${COM_BASE}/model/med/restart"
    export COMOUT_OCEAN_RESTART="${COM_BASE}/model/ocean/restart"
    export COMOUT_OCEAN_HISTORY="${COM_BASE}/model/ocean/history"
fi

if [[ "${DO_ICE}" == "YES" ]]; then
    export COMIN_ICE_INPUT="${COM_BASE}/model/ice/input"
    export COMIN_ICE_ANALYSIS="${COM_BASE}/analysis/ice"
    export COMOUT_ICE_RESTART="${COM_BASE}/model/ice/restart"
    export COMOUT_ICE_HISTORY="${COM_BASE}/model/ice/history"
fi

if [[ "${DO_AERO_FCST}" == "YES" ]]; then
    export COMOUT_CHEM_HISTORY="${COM_BASE}/model/chem/history"
    export COMIN_CHEM_INPUT="${COM_BASE}/model/chem/input"
fi

# Previous Cycle ICs
# Restart conditions for GFS cycle come from GDAS
# Restart conditions for GCAFS cycle come from GCDAS
rCDUMP="${RUN/gfs/gdas}"
rCDUMP="${rCDUMP/gcafs/gcdas}"

# Calculate previous cycle date/time
GDATE=$(date --utc -d "${PDY} ${cyc} - ${assim_freq} hours" +%Y%m%d%H)
gPDY="${GDATE:0:8}"
gcyc="${GDATE:8:2}"

# Resolved path for previous cycle restarts
export COMIN_ATMOS_RESTART_PREV="${ROTDIR}/${rCDUMP}.${gPDY}/${gcyc}/model/atmos/restart"

if [[ "${DO_WAVE}" == "YES" ]]; then
    export COMIN_WAVE_RESTART_PREV="${ROTDIR}/${rCDUMP}.${gPDY}/${gcyc}/model/wave/restart"
fi
if [[ "${DO_OCN}" == "YES" ]]; then
    export COMIN_OCEAN_RESTART_PREV="${ROTDIR}/${rCDUMP}.${gPDY}/${gcyc}/model/ocean/restart"
    export COMIN_MED_RESTART_PREV="${ROTDIR}/${rCDUMP}.${gPDY}/${gcyc}/model/med/restart"
fi
if [[ "${DO_ICE}" == "YES" ]]; then
    export COMIN_ICE_RESTART_PREV="${ROTDIR}/${rCDUMP}.${gPDY}/${gcyc}/model/ice/restart"
fi

###############################################################
# Run relevant pythonic forecast task
###############################################################
"${HOMEgfs}/scripts/exglobal_forecast.py"
err=$?

if [[ ${err} -ne 0 ]]; then
    echo "Forecast failed with error ${err}; ABORT!"
    exit "${err}"
fi

##############################################
# Final processing
##############################################
if [[ -e "${pgmout}" ]]; then
    cat "${pgmout}"
fi

##########################################
# Remove the Temporary working directory
##########################################
cd "${DATAROOT}" || true
if [[ "${KEEPDATA}" == "NO" ]]; then
    rm -rf "${DATA}"
fi

exit 0
